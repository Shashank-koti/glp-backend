# ==============================================================================
# Backend GitIgnore
# ==============================================================================

# Environment files containing database credentials, Cloudinary keys & JWT secrets
.env
.env.*
!.env.example
!.env.template

.env.local
.env.development.local
.env.test.local
.env.production.local

# Sensitive keys and credentials
*.pem
*.key
*.cert
*.crt
credentials.json
service-account*.json

# Dependencies
node_modules/

# Uploaded documents and files
public/uploads/
uploads/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor & OS files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.sw?

