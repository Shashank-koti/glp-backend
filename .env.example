PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/glp-pharma
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key
JWT_REFRESH_EXPIRES_IN=30d

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

FRONTEND_URL=http://localhost:5173

# Email / SMTP Configuration (All form inquiries are routed to info@glppharmastandards.com)
NOTIFICATION_EMAIL=info@glppharmastandards.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@glppharmastandards.com
SMTP_PASS=your_email_or_app_password
SMTP_FROM="GLP Pharma Standards" <info@glppharmastandards.com>
